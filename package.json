{
  "name": "dwss-convertor-cli",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "bin": {
    "dwss-convertor-cli": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --target bun --outdir dist",
    "build:windows": "bun build ./src/cli.ts  --minify --compile --target bun-windows-x64 --outfile dist/dwss-convertor-cli.exe",
    "build:linux:x64": "bun build ./src/cli.ts  --minify --compile --target bun-linux-x64 --outfile dist/dwss-convertor-cli-linux-x64",
    "build:linux:arm64": "bun build ./src/cli.ts  --minify --compile --target bun-linux-arm64 --outfile dist/dwss-convertor-cli-linux-arm64",
    "build:macos:x64": "bun build ./src/cli.ts  --minify --compile --target bun-darwin-x64 --outfile dist/dwss-convertor-cli-macos-x64",
    "build:macos:arm64": "bun build ./src/cli.ts  --minify --compile --target bun-darwin-arm64 --outfile dist/dwss-convertor-cli-macos-arm64",
    "build:all": "bun run build:windows && bun run build:linux:x64 && bun run build:linux:arm64 && bun run build:macos:x64 && bun run build:macos:arm64"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "docx": "^9.7.1",
    "docx-templates": "^4.11.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "bun-types": "^1.3.12",
    "typescript": "^5.9.2"
  }
}
